# ==============================================================================
# PrivAI — Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env   (or 'Copy-Item .env.example .env' in PowerShell)
# 2. Modify parameters below as needed for your local environment.
# 3. NEVER commit your '.env' file or any real API keys/credentials to Git!
# ==============================================================================

# Application Environment Mode ('development', 'staging', 'production')
ENVIRONMENT=development

# AI Provider Mode: 'mock' (safe local deterministic adapter) or 'groq' (Groq Cloud API)
# Default is 'mock' for safe offline demonstrations without third-party egress.
PROVIDER_MODE=mock

# Active Policy & Detector Configuration
POLICY_VERSION=policy-v1
POLICY_LOADED=true
DETECTOR_VERSION=detector-v1

# Security & Payload Constraints (Per PrivAI Security Blueprint)
# 32 KiB maximum HTTP request body size; 10 KiB maximum prompt UTF-8 length
MAX_BODY_SIZE_BYTES=32768
MAX_PROMPT_SIZE_BYTES=10240

# Groq Cloud Provider Settings (Optional — Live AI Dispatch)
# Required only if PROVIDER_MODE=groq is explicitly selected.
# Obtain key at: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
PROVIDER_TIMEOUT_SECONDS=20.0
PROVIDER_MAX_RETRIES=1

# Enterprise KMS & Secrets Management (Local dev/testing vs. Vault)
# KMS Provider: 'local' (offline development/testing) or 'vault' (HashiCorp Vault)
KMS_PROVIDER=local
KMS_ENDPOINT=
KMS_AUTH_TOKEN=
ACTIVE_ENCRYPTION_KEY_ID=enc-key-v1
ACTIVE_PERMIT_KEY_ID=permit-key-v1
KMS_CACHE_TTL_SECONDS=300
KMS_TIMEOUT_SECONDS=5.0
KMS_VAULT_MOUNT=secret
KMS_KEY_PATH_PREFIX=privai
KMS_ALLOW_LOCAL_FALLBACK=false

# External Audit Checkpoint Anchoring (Local mock vs. REST ledger)
# Provider mode: 'local' (offline dev/testing) or 'production' (REST transparency log)
AUDIT_ANCHOR_PROVIDER=local
AUDIT_ANCHOR_ENDPOINT=
AUDIT_ANCHOR_AUTH_TOKEN=
AUDIT_ANCHOR_TIMEOUT_SECONDS=5.0
AUDIT_ANCHOR_MAX_RETRIES=2
AUDIT_ANCHOR_REQUIRED=true
AUDIT_CHECKPOINT_EPOCH_SIZE=100

# SQLite Database Isolation Settings
# In development/staging, isolated runtime files are used automatically.
DATABASE_PATH=privai_dev.db
AGENT_DATABASE_PATH=privai_agent.db
EMPLOYEE_DEMO_DATABASE_PATH=privai_demo_employees.db
HISTORICAL_DATABASE_PATH=privai_data.db

# Human Review & Single-Use Permit Cryptographic Settings
# These defaults are safe for local development and are overridden in production.
JWT_SECRET_KEY=privai-dev-jwt-secret-replace-in-production-only-32bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=privai-auth
JWT_AUDIENCE=privai-api
REVIEW_PERMIT_SECRET=privai-dev-permit-signing-secret-key-32bytes-min
REVIEW_TICKET_TTL_HOURS=24
REVIEW_PERMIT_TTL_SECONDS=300

# PrivAI Secure Task Agent Operational Bounds
AGENT_MAX_STEPS=5
AGENT_MAX_RETRIES=2
AGENT_TIMEOUT_SECONDS=30.0
SAFE_DOCUMENTS_DIR=safe_documents
SAFE_REPORTS_DIR=agent_reports
